<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>

        <Console name="MainConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n"/>
        </Console>

        <Console name="AppConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss} %c{1} - %msg%n"/>
        </Console>

        <File name="FileLogger" fileName="logs/application.log">
            <PatternLayout pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss} %c{1} - %msg%n"/>
        </File>

    </Appenders>

    <Loggers>

        <Logger name="fr.univartois.butinfo.sae.cabinet" level="debug" additivity="true">
            <AppenderRef ref="LOGFILE"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="AppConsole"/>
            <AppenderRef ref="FileLogger"/>
        </Root>

    </Loggers>

</Configuration>